{
  "name": "zombies-game-cod",
  "version": "1.0.0",
  "description": "Top-Down Zombie Shooter: a 2D survival wave game built with vanilla JavaScript and HTML5 Canvas.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node server.mjs 8080",
    "map": "python3 tools/genmap.py",
    "sprites": "node tools/preview.mjs tools/sprites_preview.png",
    "test": "node --test tests/*.test.mjs tools/harness/*.test.mjs",
    "test:regression": "node tools/harness/regression.mjs"
  },
  "keywords": [
    "game",
    "zombies",
    "canvas",
    "pixel-art",
    "top-down",
    "call-of-duty"
  ],
  "license": "MIT"
}
